REGISTRY_URL=https://your-public-registry.example
WORKER_TOKEN=replace-with-a-long-random-secret
RATE_LIMIT_SALT=replace-with-another-random-secret
YT_DLP_BINARY=yt-dlp
# permissioned = Creative Commons videos plus channel IDs listed below.
# Set to 1 only if you have permission to process every submitted source.
ALLOW_AUDIO_FALLBACK=permissioned
PERMISSIONED_CHANNEL_IDS=
ASR_ENGINE=whisper-cpp
MLX_WHISPER_MODEL=mlx-community/whisper-small-mlx
# WHISPER_CPP_BINARY=/absolute/path/to/whisper-cli
# WHISPER_CPP_MODEL=/absolute/path/to/ggml-small.en.bin
