REGISTRY_URL=https://transcript-registry.vercel.app
WORKER_TOKEN=use-the-same-worker-token-as-the-website
YT_DLP_BINARY=yt-dlp
# "permissioned" allows local ASR only for Creative Commons or listed channels.
# Use "1" only when you have permission to process every submitted source.
ALLOW_AUDIO_FALLBACK=permissioned
PERMISSIONED_CHANNEL_IDS=
ASR_ENGINE=whisper-cpp
MLX_WHISPER_MODEL=mlx-community/whisper-small-mlx
# WHISPER_CPP_BINARY=/absolute/path/to/whisper-cli
# WHISPER_CPP_MODEL=/absolute/path/to/ggml-small.en.bin
